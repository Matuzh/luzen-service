{
    "name": "luzen-backend",
    "version": "1.0.0",
    "description": "LuzeN Computer Service Backend API",
    "main": "dist/server.js",
    "directories": {
        "test": "tests"
    },
    "keywords": [
        "express",
        "typescript",
        "api",
        "prisma"
    ],
    "author": "Mateusz Szuper - LuzeN",
    "license": "ISC",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "start": "node dist/server.js",
        "build": "tsc",
        "prisma:migrate": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "postinstall": "prisma generate",
        "prisma:studio": "prisma studio",
        "prisma:push": "prisma db push",
        "seed": "ts-node prisma/seed.ts",
        "test": "jest",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@prisma/client": "^6.17.1",
        "bcryptjs": "^3.0.2",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^8.1.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "nodemailer": "^7.0.9",
        "pg": "^8.16.3",
        "psql": "^0.0.1",
        "socket.io": "^4.8.1",
        "stripe": "^18.5.0",
        "swagger-jsdoc": "^3.7.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.9.0",
        "@types/nodemailer": "^7.0.2",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-node": "^11.1.0",
        "jest": "^30.2.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "prisma": "^6.17.1",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.4",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    }
}
